            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="40sp"
            android:backgroundTint="#5E35B1"
            android:text="@string/btnstr_backspace"/>
        <Button
            android:id="@+id/FuncCalButtonAC"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="none"
            android:maxLines="1"
            android:textSize="17sp"
            android:backgroundTint="#5E35B1"
            android:text="@string/btnstr_ac"/>



        <Button
            android:id="@+id/FuncCalButton4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="35sp"
            android:text="@string/btnstr_4"/>
        <Button
            android:id="@+id/FuncCalButton5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="35sp"
            android:text="@string/btnstr_5"/>
        <Button
            android:id="@+id/FuncCalButton6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="35sp"
            android:text="@string/btnstr_6"/>
        <Button
            android:id="@+id/FuncCalButtonMul"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="40sp"
            android:backgroundTint="#5E35B1"
            android:text="@string/btnstr_mul"/>
        <Button
            android:id="@+id/FuncCalButtonDiv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="40sp"
            android:backgroundTint="#5E35B1"
            android:text="@string/btnstr_div"/>



        <Button
            android:id="@+id/FuncCalButton1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="35sp"
            android:text="@string/btnstr_1"/>
        <Button
            android:id="@+id/FuncCalButton2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="35sp"
            android:text="@string/btnstr_2"/>
        <Button
            android:id="@+id/FuncCalButton3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="35sp"
            android:text="@string/btnstr_3"/>
        <Button
            android:id="@+id/FuncCalButtonAdd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="35sp"
            android:backgroundTint="#5E35B1"
            android:text="@string/btnstr_add"/>
        <Button
            android:id="@+id/FuncCalButtonSub"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="40sp"
            android:backgroundTint="#5E35B1"
            android:text="@string/btnstr_sub"/>




        <Button
            android:id="@+id/FuncCalButtonMode"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:ellipsize="none"
            android:maxLines="1"
            android:textSize="8sp"
            android:backgroundTint="#5E35B1"
            android:text="@string/btnstr_mode"/>
        <Button
            android:id="@+id/FuncCalButton0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="35sp"
            android:text="@string/btnstr_0"/>
        <Button
            android:id="@+id/FuncCalButtonCom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="30sp"
            android:text="@string/btnstr_com"/>
        <Button
            android:id="@+id/FuncCalButtonMem"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:textSize="25sp"
            android:backgroundTint="#5E35B1"
            android:text="@string/btnstr_memo"/>
        <Button
            android:id="@+id/FuncCalButtonEqu"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_marginStart="10dp"
            android:backgroundTint="#00bfff"
            android:textSize="40sp"
            android:text="@string/btnstr_equ"/>


    </GridLayout>


</LinearLayout>